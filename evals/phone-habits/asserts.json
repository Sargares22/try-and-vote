[
 {
  "name": "with the undo bar: a tick shows \"Отменить\"; pressing it takes the bar away and the tick with it",
  "tab": "undo",
  "variant": 1,
  "steps": [
   {
    "press": {
     "nth": 0
    }
   },
   {
    "expectMarksChanged": true
   },
   {
    "expect": "Отменить"
   },
   {
    "click": "Отменить"
   },
   {
    "expectNot": "Отменить"
   },
   {
    "expectMarksBack": true
   }
  ]
 },
 {
  "name": "as now: a tick shows no undo bar",
  "tab": "undo",
  "variant": 0,
  "steps": [
   {
    "press": {
     "nth": 0
    }
   },
   {
    "expectNot": "Отменить"
   }
  ]
 },
 {
  "name": "skipping a habit changes the screen and the streak number stays what it was",
  "tab": "skip",
  "steps": [
   {
    "click": "Пропустить"
   },
   {
    "expectChange": true
   },
   {
    "expectKept": "\\d+\\s*(?:дн|день|дня|дней)|сери[яию]\\D{0,15}\\d+|\\d+\\D{0,6}сери"
   }
  ]
 }
]